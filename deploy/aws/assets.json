{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Container image repository for authenticated MCP; immutable image tags and retained artifacts.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        {
          "at": "deploy/aws/README.md",
          "has": "deployment architecture and lifecycle"
        }
      ]
    }
  },
  "Resources": {
    "Images": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Store versioned container images without overwriting release tags",
          "must": [
            "Retain images on stack deletion"
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Images",
          "RepositoryUri"
        ]
      }
    },
    "RepositoryArn": {
      "Value": {
        "Fn::GetAtt": [
          "Images",
          "Arn"
        ]
      }
    }
  }
}
