{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyThisRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-2:928967252914:repository/deep-agentic-core-mcp-assets-images-aaymbdhgnqgg"
    },
    {
      "Sid": "ReadDeploymentStacks",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": [
        "arn:aws:cloudformation:us-east-2:928967252914:stack/deep-agentic-core-mcp/*",
        "arn:aws:cloudformation:us-east-2:928967252914:stack/deep-agentic-core-mcp-assets/*"
      ]
    },
    {
      "Sid": "CreateServiceChangeSet",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:us-east-2:928967252914:stack/deep-agentic-core-mcp/*",
      "Condition": {
        "StringLike": {
          "cloudformation:ChangeSetName": "ci-*"
        }
      }
    },
    {
      "Sid": "ServiceChangeSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeEvents",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeStackResources"
      ],
      "Resource": "arn:aws:cloudformation:us-east-2:928967252914:stack/deep-agentic-core-mcp/*"
    },
    {
      "Sid": "RegisterNewRevision",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "TaskRevisions",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-2:928967252914:task-definition/deep-agentic-core-mcp-task:*",
        "arn:aws:ecs:us-east-2:928967252914:task-definition/deep-agentic-core-mcp-TaskDefinition-D1tINPnUHQp8:*"
      ]
    },
    {
      "Sid": "UpdateOnlyThisService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "ecs:ListTagsForResource",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:us-east-2:928967252914:service/deep-agentic-core-mcp-Cluster-Bx9sr5nCof0S/deep-agentic-core-mcp-Service-0A5wVcO8WPnt"
    },
    {
      "Sid": "PassExistingRuntimeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::928967252914:role/deep-agentic-core-mcp-ExecutionRole-FpXBJrGsHKlq",
        "arn:aws:iam::928967252914:role/deep-agentic-core-mcp-TaskRole-nJhKcwxEmaBH"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadRuntimeRoleMetadata",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::928967252914:role/deep-agentic-core-mcp-ExecutionRole-FpXBJrGsHKlq",
        "arn:aws:iam::928967252914:role/deep-agentic-core-mcp-TaskRole-nJhKcwxEmaBH"
      ]
    }
  ]
}
